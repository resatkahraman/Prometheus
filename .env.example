# ============================================================
# PROMETHEUS v0.8 — FREE WORKER RUNTIME
# ============================================================

APP_NAME=Prometheus

# Güvenli varsayılan: HTTP isteklerini yalnızca localhost istemcilerinden kabul et.
HTTP_REMOTE_ACCESS_ENABLED=false
# Uzak erişim açılırsa en az 32 karakterlik güçlü ve benzersiz bir token zorunludur.
# Tarayıcı Basic Auth kullanıcı adı: prometheus; parola: bu token.
# API istemcileri Authorization: Bearer <token> kullanabilir.
HTTP_AUTH_TOKEN=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

GITHUB_TOKEN=
GITHUB_MODEL=openai/gpt-4.1-mini
GITHUB_BASE_URL=https://models.github.ai
GITHUB_API_VERSION=2026-03-10
GITHUB_ROUTE_ENABLED=true

GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_STRONG_MODEL=llama-3.3-70b-versatile

# Enable after installing Ollama and pulling the configured model.
LOCAL_MODEL_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_EXPERT_MODEL=qwen3.5:9b
OLLAMA_CONTEXT_TOKENS=4096
OLLAMA_MAX_OUTPUT_TOKENS=3072
OLLAMA_KEEP_ALIVE=2m
LOCAL_MODEL_TIMEOUT_SECONDS=180
LOCAL_EXPERT_TIMEOUT_SECONDS=180
LOCAL_MODEL_MAX_INPUT_CHARS=18000
LOCAL_MODEL_MAX_SOURCE_CHARS=9000
# 0 = sınırsız yerel deneme; görev/kalite/durgunluk kapıları yine etkindir.
LOCAL_MODEL_MAX_ATTEMPTS_PER_TASK=2

FALLBACK_ORDER=groq_fast,gemini,github,groq_strong

REQUEST_TIMEOUT_SECONDS=75
PROVIDER_CALL_WALL_TIMEOUT_SECONDS=90
MAX_RETRIES=2
MAX_INPUT_CHARS=40000
MAX_OUTPUT_TOKENS=1600
GROQ_FAST_MAX_OUTPUT_TOKENS=700
MAX_PARALLEL_PROVIDERS=3

GEMINI_DAILY_REQUEST_BUDGET=450
GITHUB_DAILY_REQUEST_BUDGET=120
GROQ_FAST_DAILY_REQUEST_BUDGET=500
GROQ_STRONG_DAILY_REQUEST_BUDGET=150
VERIFY_DAILY_BUDGET=15

# Free-first governor. FREE_ONLY_MODE is the master paid-route lock.
FREE_ONLY_MODE=true
PAID_MODELS_ENABLED=false
MONTHLY_PAID_BUDGET_USD=0
MISSION_BUDGET_ENABLED=true
MISSION_MAX_MODEL_CALLS=24
MISSION_MAX_ESTIMATED_INPUT_TOKENS=60000
FREE_QUOTA_CONSERVE_RATIO=0.10
FREE_QUOTA_MAX_PRESSURE_PENALTY=35
FREE_PROVIDER_MAX_RETRIES=1

CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400
OPERATIONS_DATABASE_PATH=data/orchestra_ops.db

CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_COOLDOWN_SECONDS=300

AGENT_MAX_STEPS=12
AGENT_MAX_MODEL_CALLS=16
AGENT_STEP_OUTPUT_TOKENS=1000
AGENT_TOOL_RESULT_MAX_CHARS=12000
AGENT_SESSION_TTL_SECONDS=3600
AGENT_QUALITY_MAX_RETRIES=2
AGENT_AUTO_CONTEXT_MAX_FILES=4
AGENT_AUTO_CONTEXT_MAX_LINES=180
PROJECT_MEMORY_ENABLED=true
PROJECT_MEMORY_DATABASE_PATH=.adam/project_memory.db
PROJECT_MEMORY_ATTENTION_BUDGET_CHARS=800
PROJECT_MEMORY_HYPOTHESES_ENABLED=true
AGENT_CONTEXT_MAX_CHARS=24000
AGENT_CONTEXT_BASE_MAX_CHARS=14000
AGENT_PROJECT_CONTEXT_MAX_CHARS=7000
AGENT_CONTEXT_MEMORY_MAX_CHARS=3000
AGENT_CONTEXT_RECENT_MESSAGES=2
AGENT_TOOL_CONTENT_MAX_CHARS=6000
AGENT_CONTEXT_EXPANSION_MAX_REQUESTS=2
AGENT_CONTEXT_EXPANSION_MAX_FILES=3
AGENT_CONTEXT_EXPANSION_MAX_LINES=220
AGENT_GENERATED_EVIDENCE_MAX_RETRIES=2
PLANNING_INTEGRITY_STRICT=true
PLANNING_MAX_TASKS=24
DELIVERY_STATUS_GUARD_ENABLED=true
EXECUTION_EVIDENCE_GUARD_ENABLED=true
PROTOCOL_REPAIR_MAX_RETRIES=2

# Prometheus may only access this folder and its descendants.
# Example:
# PROMETHEUS_WORKSPACE_ROOT=C:\Users\Resat\Desktop\MyProject
PROMETHEUS_WORKSPACE_ROOT=workspace
# Legacy ADAM_WORKSPACE_ROOT remains accepted for existing installations.
# ADAM_WORKSPACE_ROOT=workspace

WORKSPACE_MAX_FILE_BYTES=1000000
WORKSPACE_MAX_SEARCH_RESULTS=100
COMMAND_TIMEOUT_SECONDS=300
COMMAND_OUTPUT_MAX_CHARS=30000
APPROVAL_TTL_SECONDS=1800

USAGE_LOG_PATH=data/usage.jsonl
# Arena dashboard reads direct arena*.db files from this directory.
ARENA_HISTORY_DIRECTORY=data
ARENA_HISTORY_MAX_DATABASES=100

SUPERVISOR_COMMAND_TTL_SECONDS=21600
SUPERVISOR_MAX_TASK_ATTEMPTS=3
SUPERVISOR_AUTO_REVIEW=true
SUPERVISOR_MAX_EVENTS=300

SUPERVISOR_PLANNER_ATTEMPTS=3
SUPERVISOR_PLANNER_RETRY_ROUTES=true

SUPERVISOR_PLANNER_ATTEMPT_TIMEOUT_SECONDS=110
SUPERVISOR_PLANNER_TOTAL_TIMEOUT_SECONDS=300
SUPERVISOR_OPERATION_HEARTBEAT_SECONDS=4
SUPERVISOR_STALE_OPERATION_SECONDS=150

SUPERVISOR_PLANNER_ENGINE=typed_kernel
SUPERVISOR_PLANNER_READ_MAX_LINES=120

AGENT_APPROVAL_REPLAY_TTL_SECONDS=3600
AGENT_POST_APPROVAL_EXTRA_STEPS=5
AGENT_POST_APPROVAL_EXTRA_MODEL_CALLS=6
SUPERVISOR_APPROVAL_BACKGROUND=true
SUPERVISOR_RECOVER_AFTER_APPLIED_TOOL=true

SUPERVISOR_APPROVAL_TOOL_TIMEOUT_SECONDS=210
SUPERVISOR_AGENT_CONTINUATION_TIMEOUT_SECONDS=90
SUPERVISOR_CANCELLATION_GRACE_SECONDS=1

SUPERVISOR_MAX_CONTINUATION_RESUMES=8

SUPERVISOR_TASK_AGENT_MAX_STEPS=24
SUPERVISOR_TASK_AGENT_MAX_MODEL_CALLS=28
SUPERVISOR_FRESH_RECOVERY_TIMEOUT_SECONDS=150
SUPERVISOR_AUTO_EVIDENCE_RECONCILE=true
SUPERVISOR_MAX_CONTINUATION_RESUMES=20

SUPERVISOR_TASK_AGENT_TIMEOUT_SECONDS=300
SUPERVISOR_REVIEWER_TIMEOUT_SECONDS=180
# A continuous mission stops at completion, failure, a decision, or an approval.
SUPERVISOR_AUTO_RUN_MAX_TASKS=24
SUPERVISOR_SINGLE_ACTIVE_TASK=true

SUPERVISOR_FOCUSED_STEP_TIMEOUT_SECONDS=180
# Geçici provider/timeout hatasında aynı dosya adımını uzaktan bir kez yeniden dener.
SUPERVISOR_FOCUSED_PROVIDER_RETRY_LIMIT=1
SUPERVISOR_FOCUSED_STEP_MAX_STEPS=5
SUPERVISOR_FOCUSED_STEP_MAX_MODEL_CALLS=5

SUPERVISOR_PERSISTENCE_ENABLED=true
SUPERVISOR_DATABASE_PATH=.adam/supervisor.db
SUPERVISOR_DEFAULT_AUTONOMY_MODE=task
SUPERVISOR_TRUSTED_AUTONOMY_ENABLED=false
SUPERVISOR_SAME_FAILURE_LIMIT=2

# Terminal runtime is internal and reported for diagnostics.

SUPERVISOR_FOCUSED_FILE_OUTPUT_TOKENS=8192
SUPERVISOR_FOCUSED_CONTEXT_MAX_CHARS=8000
SUPERVISOR_FOCUSED_RELATED_FULL_FILES=1
